{
  "name": "nodemem",
  "version": "0.1.0",
  "private": false,
  "description": "Provider-agnostic passive memory for agent systems — notices entities in activity streams, surfaces noteworthy suggestions, learns from dismissals, and deduplicates.",
  "type": "module",
  "license": "MIT",
  "author": "Homen Shum",
  "homepage": "https://github.com/HomenShum/NodeMem",
  "repository": {
    "type": "git",
    "url": "https://github.com/HomenShum/NodeMem.git"
  },
  "keywords": [
    "agent",
    "memory",
    "passive-intelligence",
    "entity-detection",
    "dedup",
    "dismissal-learning",
    "convex",
    "context-engineering"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "demo": "tsx demo/runNodeMemDemo.ts",
    "demo:node": "node demo/runNodeMemDemo.mjs",
    "proof": "tsx demo/runNodeMemDemo.ts --json-out=docs/eval/nodemem-smoke.json",
    "doctor": "npm run proof",
    "capture": "node scripts/capture-graph-rail.mjs",
    "audit:web": "node scripts/audit-web-quality.mjs",
    "audit:wig": "node scripts/wig-review.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "npm run secret-scan && npm run typecheck && npm run test && npm run proof"
  },
  "dependencies": {
    "convex": "^1.41.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
